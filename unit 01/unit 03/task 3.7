class Car {
    var brand: String
    var speed: Int

    init(brand: String, speed: Int) {
        self.brand = brand
        self.speed = speed
    }

    func accelerate() {
        speed += 20
    }

    func brake() {
        speed = max(0, speed - 20)
    }
}

let car = Car(brand: "BMW", speed: 40)

car.accelerate()
print(car.speed)

car.brake()
print(car.speed)
