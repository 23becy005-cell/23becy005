enum Grade {
    case A, B, C, D, F

    static func calculate(marks: Int) -> Grade {
        switch marks {
        case 90...100: return .A
        case 80..<90: return .B
        case 70..<80: return .C
        case 40..<70: return .D
        default: return .F
        }
    }
}

struct Student {
    var name: String
    var rollNumber: Int
    var marks: Int

    var grade: Grade {
        return Grade.calculate(marks: marks)
    }
}

class School {
    var students: [Student] = []

    func addStudent(_ student: Student) {
        students.append(student)
    }

    func printReport() {
        let sortedStudents = students.sorted {
            $0.marks > $1.marks
        }

        print("STUDENT REPORT")

        for student in sortedStudents {
            print(
                "\(student.rollNumber) \(student.name) - Marks: \(student.marks), Grade: \(student.grade)"
            )
        }
    }
}

let school = School()

school.addStudent(
    Student(name: "Asad", rollNumber: 101, marks: 85)
)

school.addStudent(
    Student(name: "Rahul", rollNumber: 102, marks: 95)
)

school.addStudent(
    Student(name: "Arun", rollNumber: 103, marks: 65)
)

school.printReport()
